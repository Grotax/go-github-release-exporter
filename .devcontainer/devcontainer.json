{
  "name": "Go Dev Container",
  "image": "mcr.microsoft.com/devcontainers/go:1-trixie",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go"
      ],
      "settings": {
        "go.useLanguageServer": true,
        "go.toolsManagement.autoUpdate": true
      }
    }
  },
  "postCreateCommand": "go version && go mod tidy",
  "remoteUser": "vscode"
}